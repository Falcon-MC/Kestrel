if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "INPUT and OUTPUT are required")
endif()
set(iconset "${OUTPUT}.iconset")
file(MAKE_DIRECTORY "${iconset}")
foreach(size IN ITEMS 16 32 128 256 512)
    foreach(scale IN ITEMS 1 2)
        math(EXPR pixels "${size} * ${scale}")
        if(scale EQUAL 2)
            set(name "icon_${size}x${size}@2x.png")
        else()
            set(name "icon_${size}x${size}.png")
        endif()
        execute_process(COMMAND /usr/bin/sips -z ${pixels} ${pixels} "${INPUT}" --out "${iconset}/${name}"
            RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Cannot resize the application icon: ${error}")
        endif()
    endforeach()
endforeach()
execute_process(COMMAND /usr/bin/iconutil -c icns "${iconset}" -o "${OUTPUT}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot build the application icon: ${error}")
endif()
file(REMOVE_RECURSE "${iconset}")
