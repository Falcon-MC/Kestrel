+static void destroyIcon(_GLFWwindow* window)
+{
+    if (window->wl.icon)
+        xdg_toplevel_icon_v1_destroy(window->wl.icon);
+
+    for (int i = 0;  i < window->wl.iconBufferCount;  i++)
+        wl_buffer_destroy(window->wl.iconBuffers[i]);
+
+    _glfw_free(window->wl.iconBuffers);
+    window->wl.icon = NULL;
+    window->wl.iconBuffers = NULL;
+    window->wl.iconBufferCount = 0;
+}
+
+static GLFWbool applyIcon(_GLFWwindow* window)
+{
+    struct xdg_toplevel* toplevel = window->wl.xdg.toplevel;
+    if (window->wl.libdecor.frame)
+        toplevel = libdecor_frame_get_xdg_toplevel(window->wl.libdecor.frame);
+
+    if (!_glfw.wl.toplevelIconManager || !toplevel)
+        return GLFW_FALSE;
+
+    xdg_toplevel_icon_manager_v1_set_icon(_glfw.wl.toplevelIconManager,
+                                          toplevel,
+                                          window->wl.icon);
+    return GLFW_TRUE;
+}
+
 static void createFallbackEdge(_GLFWwindow* window,
                                _GLFWfallbackEdgeWayland* edge,
                                struct wl_surface* parent,
@@ -862,6 +892,10 @@ static GLFWbool createLibdecorFrame(_GLFWwindow* window)
     }
 
     libdecor_frame_map(window->wl.libdecor.frame);
+
+    if (window->wl.icon)
+        applyIcon(window);
+
     wl_display_roundtrip(_glfw.wl.display);
     return GLFW_TRUE;
 }
